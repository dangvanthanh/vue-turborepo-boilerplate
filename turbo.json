{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["build/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"cache": false
		},
		"format": {
			"dependsOn": ["^format"],
			"cache": false
		},
		"update": {
			"dependsOn": ["^update"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
